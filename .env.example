# Local development defaults (copy to .env and adjust)
DATABASE_URL=postgresql+psycopg://tt:tt_dev@localhost:5432/tt_aufstellung

# Web server port (Render sets PORT automatically)
PORT=10000

# Optional: protects admin/write API routes (refresh, imports, validation tools).
# Leave empty for local dev without a token. Set a long random string in production.
ADMIN_TOKEN=

# Production only: block data refresh until this date (ISO), e.g. summer pause until season start.
# DATA_REFRESH_NOT_BEFORE=2026-10-05

# Weekly refresh report e-mail — recipient (private inbox is fine).
REFRESH_REPORT_EMAIL_TO=p.schuetzeneder@gmail.com

# Outbound mail via Postfix on the VPS (see deploy/postfix/setup-postfix.sh).
# SMTP_HOST is set automatically to the Docker bridge gateway (e.g. 172.19.0.1).
SMTP_HOST=
SMTP_PORT=25
SMTP_USE_TLS=0
SMTP_USE_AUTH=0
SMTP_FROM=tt-aufstellung@tt-aufstellung.at
SMTP_USER=
SMTP_PASSWORD=

# Only used by scripts/clone-render-db.ps1 — never commit real values
# RENDER_DATABASE_URL=postgres://user:password@host:5432/dbname
# POSTGRES_SUPERUSER_PASSWORD=your-local-postgres-password
